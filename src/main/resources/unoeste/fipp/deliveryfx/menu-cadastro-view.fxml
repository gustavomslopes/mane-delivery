<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="563.0" prefWidth="555.0" spacing="30.0" style="-fx-background-color: orange;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unoeste.fipp.deliveryfx.MenuCadastroController">
   <children>
      <Label text="Cadastros">
         <font>
            <Font name="Arial Rounded MT Bold" size="36.0" />
         </font>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </Label>
      <Button mnemonicParsing="false" onAction="#onMenuCategoria" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: darkred; -fx-background-radius: 15;" text="Categoria" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button mnemonicParsing="false" onAction="#onMenuPagamento" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: darkred; -fx-background-radius: 15;" text="Tipo Pagamento" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button mnemonicParsing="false" onAction="#onMenuMarca" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: darkred; -fx-background-radius: 15;" text="Marca" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button mnemonicParsing="false" onAction="#onMenuProduto" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: darkred; -fx-background-radius: 15;" text="Produto" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button mnemonicParsing="false" onAction="#onMenuPedido" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: darkred; -fx-background-radius: 15;" text="Pedido" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
</VBox>
