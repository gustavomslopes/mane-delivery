<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="555.0" prefWidth="555.0" spacing="30.0" style="-fx-background-color: orange;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unoeste.fipp.deliveryfx.menus.MenuMovimentacaoController">
   <children>
      <Label text="Movimentações">
         <font>
            <Font name="Arial Rounded MT Bold" size="36.0" />
         </font>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </Label>
      <Button mnemonicParsing="false" prefHeight="51.0" prefWidth="275.0" style="-fx-background-color: darkred; -fx-background-radius: 15;" text="Novo Pedido" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button mnemonicParsing="false" onAction="#onPedidosNEntregues" prefHeight="51.0" prefWidth="275.0" style="-fx-background-color: darkred; -fx-background-radius: 15;" text="Pedidos não entregues" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button mnemonicParsing="false" onAction="#onPainelPedidos" prefHeight="48.0" prefWidth="275.0" style="-fx-background-color: darkred; -fx-background-radius: 15;" text="Todos os Pedidos" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
</VBox>
