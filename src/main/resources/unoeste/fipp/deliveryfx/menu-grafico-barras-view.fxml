<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox alignment="CENTER" prefHeight="467.0" prefWidth="444.0" style="-fx-background-color: orange;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unoeste.fipp.deliveryfx.graficos.MenuGraficoBarrasController">
   <children>
      <Label text="Mês e ano para gráfico" textAlignment="CENTER">
         <font>
            <Font name="Arial Rounded MT Bold" size="36.0" />
         </font>
      </Label>
      <DatePicker fx:id="dpGraficoBarras">
         <VBox.margin>
            <Insets bottom="35.0" top="35.0" />
         </VBox.margin>
      </DatePicker>
      <Button mnemonicParsing="false" onAction="#onGerarGraficoBarras" style="-fx-background-color: darkred;" text="Gerar gráfico" textFill="WHITE">
         <font>
            <Font name="Arial Rounded MT Bold" size="24.0" />
         </font>
      </Button>
   </children>
</VBox>
