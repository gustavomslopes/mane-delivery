<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="555.0" prefWidth="555.0" spacing="60.0" style="-fx-background-color: orange;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unoeste.fipp.deliveryfx.menus.MenuPrincipalController">
   <children>
      <ImageView fx:id="imageView" fitHeight="121.0" fitWidth="143.0" pickOnBounds="true" preserveRatio="true">
         <VBox.margin>
            <Insets bottom="-40.0" />
         </VBox.margin></ImageView>
      <Label text="Mané Delivery">
         <font>
            <Font name="Arial Rounded MT Bold" size="36.0" />
         </font>
      </Label>
      <Button mnemonicParsing="false" onAction="#onMenuCadastro" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: darkred; -fx-background-radius: 15;" text="Cadastros" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button mnemonicParsing="false" onAction="#onMenuMovimentacao" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: darkred; -fx-background-radius: 15;" text="Movimentações" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button mnemonicParsing="false" onAction="#onMenuRelatorio" prefHeight="48.0" prefWidth="220.0" style="-fx-background-color: darkred; -fx-background-radius: 15;" text="Relatórios" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
</VBox>
