<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="540.0" prefWidth="504.0" style="-fx-background-color: orange;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unoeste.fipp.deliveryfx.relatorios.PedidoPorDataPDFController">
   <children>
      <Label text="Pedido por data PDF">
         <font>
            <Font name="Arial Rounded MT Bold" size="36.0" />
         </font>
      </Label>
      <DatePicker fx:id="dpDataPedidoPdf">
         <VBox.margin>
            <Insets bottom="35.0" top="35.0" />
         </VBox.margin>
      </DatePicker>
      <Button mnemonicParsing="false" onAction="#OnGerarDatPedidoPdf" style="-fx-background-radius: 15px; -fx-background-color: darkred;" text="Gerar PDF" textFill="WHITE">
         <font>
            <Font size="24.0" />
         </font>
      </Button>
   </children>
</VBox>
