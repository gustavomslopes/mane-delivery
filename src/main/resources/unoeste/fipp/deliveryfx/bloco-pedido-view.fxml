<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="245.0" spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 10, 0, 0, 4);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unoeste.fipp.deliveryfx.BlocoPedidoController">
   <cursor>
      <Cursor fx:constant="HAND" />
   </cursor>
   <children>
      <!-- Cabeçalho do Card -->
      <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #8B0000; -fx-background-radius: 11 11 0 0;">
         <padding>
            <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
         </padding>
         <children>
            <HBox alignment="CENTER" spacing="1.0" style="-fx-background-color: rgba(255,255,255,0.18); -fx-background-radius: 6; -fx-padding: 2 7;">
               <children>
                  <Label text="#" textFill="#FFCDD2">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Label fx:id="lbidPedido" text="0" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Label fx:id="lbNomeCliPedido" maxWidth="165.0" text="Cliente" textFill="WHITE" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
         </children>
      </HBox>

      <VBox spacing="10.0">
         <padding>
            <Insets bottom="14.0" left="14.0" right="14.0" top="2.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label text="VALOR TOTAL" textFill="#64748B">
                     <font>
                        <Font name="System Bold" size="11.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lbValorTotalPedido" text="0,00" textFill="#16A34A">
                     <font>
                        <Font name="System Bold" size="17.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <Separator opacity="0.6" />

            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label text="Data" textFill="#64748B">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lbDataPedido" text="00/00/0000" textFill="#334155">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label text="Status" textFill="#64748B">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lbStatusPedido" style="-fx-background-color: #FEF3C7; -fx-background-radius: 20; -fx-padding: 3 10;" text="Pendente" textFill="#B45309">
                     <font>
                        <Font name="System Bold" size="11.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>